# This is a placeholder file only — do NOT put a real secret here.
#
# Generate the real secret file (secrets/session_secret.txt) with:
#   ./scripts/init-secret.sh
# or manually:
#   mkdir -p secrets && openssl rand -hex 32 > secrets/session_secret.txt && chmod 600 secrets/session_secret.txt
#
# secrets/session_secret.txt is git-ignored on purpose: the value in it signs
# session cookies, so it must never be committed to the repository.
#
# docker-compose.yml mounts this file as the SESSION_SECRET secret for the
# slag3d container.
