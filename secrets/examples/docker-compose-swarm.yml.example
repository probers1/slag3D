# Example for Docker Swarm mode with secrets
# Generate secret first: ./scripts/init-secret.sh
services:
  slag3d:
    image: slag3d:latest
    deploy:
      restart_policy:
        condition: on-failure
      resources:
        reservations:
          nodes: 1
        limits:
          cpus: '0.5'
          memory: 512M
      placement:
        constraints: [node.role == manager]
    secrets:
      - session_secret
      - database_password_secret
    environment:
      - PORT=3000
      - NODE_ENV=production
      # Secret injection (Swarm mode)
      SESSION_SECRET: ${SESSION_SECRET:-}  # Injected from secret volume at runtime

volumes:
  slag3d_data:
  slag3d_uploads:

secrets:
  session_secret:
    file: ./secrets/session_secret.txt
  database_password_secret:
    file: ./secrets/db_password.txt
