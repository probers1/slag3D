# SLAG3D Environment Configuration
# Copy this file to .env and modify as needed

# =============================================================================
# 🔐 SECURITY - REQUIRED FOR PRODUCTION
# =============================================================================
# ⚠️ CRITICAL: JWT_SECRET is REQUIRED and MUST be set
# Generate a secure random string (min 32 chars): openssl rand -base64 64
# Never commit .env to version control! Copy this file to .env and modify.
JWT_SECRET=<generate-a-secure-random-string-here> # Example: "7Kj9#mPqR2$xYvN8@wLdF5"

# =============================================================================
# 🚀 DEPLOYMENT MODE & SESSION CONFIGURATION
# =============================================================================
# true  = Development: Auto-seeds admin account (admin/admin123) on startup
# false  = Production: No auto-seeding - must create accounts yourself via UI or script
GOOSE_SEED_DB=false
DO_SEED=true

# =============================================================================
# 🕐 SESSION & COOKIE CONFIGURATION
# =============================================================================
# Session cookie max age in minutes (configurable via SESSION_EXPIRY_MINUTES)
# Default: 3360 minutes = 7 days (long for web apps, consider 1440/24h max for production)
SESSION_EXPIRY_MINUTES=3360

# ⚠️ In production: Generate a new random session secret per deployment
# For local dev: The app will generate one automatically if not set
# SESSION_SECRET (commented by default - let the app generate a secure random one)
# SESSION_SECRET=<your-secure-session-secret-if-needing>
