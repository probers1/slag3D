# =============================================================================
# SLAG3D - 3D Model Vault Server
# Environment Configuration Template
# =============================================================================
# Copy this file to .env and fill in the values with secure random strings.
# =============================================================================

# -----------------------------------------------------------------------------
# CRITICAL: Security Secrets (Generate using openssl command)
# -----------------------------------------------------------------------------
# Generate each secret with: openssl rand -base64 52
# Minimum length: 32 characters recommended, 64+ preferred for maximum security.
# The placeholders below MUST be replaced before starting the server.

JWT_SECRET=<paste-openssl-rand-base64-52-output-here>          # Access token signing secret
REFRESH_TOKEN_SECRET=<paste-openssl-rand-base64-52-output-here> # Refresh token signing secret
SESSION_SECRET=<paste-openssl-rand-base64-52-output-here>      # Session cookie signing secret

# -----------------------------------------------------------------------------
# Database Configuration
# -----------------------------------------------------------------------------
# Production: Set this to your persistent database path
# Example: DB_PATH=/data/vault.db

# -----------------------------------------------------------------------------
# Upload Storage Configuration
# -----------------------------------------------------------------------------
# Directory that holds uploaded models and rendered thumbnails.
# Default: <project root>/uploads
# Docker: /uploads (mounted volume), LXC: /opt/slag3D/uploads
# UPLOADS_DIR=/uploads

# First-run admin seeding (DEVELOPMENT / INITIAL DEPLOYMENT ONLY!)
# GOOSE_SEED_DB=true creates an admin using ADMIN_USER / ADMIN_PASSWORD when
# the users table is empty. Setting ADMIN_PASSWORD also enables seeding.
# If ADMIN_PASSWORD is omitted, the insecure default "admin123" is used.
# NOTE: seeding is skipped when users already exist. To create or reset the
# admin account on an existing database run: npm run set-admin -- 'NewPassword'
GOOSE_SEED_DB=false
# ADMIN_USER=admin
# ADMIN_PASSWORD=<generate-a-strong-password>

# -----------------------------------------------------------------------------
# Session Configuration
# -----------------------------------------------------------------------------
# Session expiry in minutes (default: 1440 = 24 hours)
SESSION_EXPIRY_MINUTES=1440

# Node environment - use 'production' for deployed instances
NODE_ENV=development

# -----------------------------------------------------------------------------
# Server Configuration
# -----------------------------------------------------------------------------
# Port to listen on (default: 3000)
PORT=3000
