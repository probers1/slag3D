# SLAG3D Environment Configuration
# Copy this file to .env and modify as needed

# =============================================================================
# 🔐 SECURITY - REQUIRED FOR PRODUCTION
# =============================================================================
# Set a strong random secret (min 32 characters, avoid common patterns)
# Generate one with: openssl rand -base64 64
JWT_SECRET=<generate-a-secure-random-string-here>

# =============================================================================
# 🚀 DEPLOYMENT MODE
# =============================================================================
# true  = Development: Auto-seeds admin account (admin/admin123) on startup
# false  = Production: No auto-seeding - must create accounts yourself via UI or script
GOOSE_SEED_DB=false
