# =============================================================================
# SLAG3D Production Docker Image
# =============================================================================
# This image enforces strict runtime secret validation at startup.
# The container will HARD REFUSE to start without properly configured secrets.
#
# SECURITY FIX #1: This prevents the critical vulnerability where containers
# could be spun up without required secrets, leaving them vulnerable to
# session hijacking and token-based attacks.
# =============================================================================

FROM node:20-bookworm-slim

# Security: Drop all privileges except necessary ones
USER node

# Set environment variables
ENV NODE_ENV=production \
    PORT=3000 \
    PUPPETEER_SKIP_CHROMIUM_DOWNLOAD=true \
    PUPPETEER_EXECUTABLE_PATH=/usr/bin/chromium

# Install system dependencies, Chromium for headless renders, and build tools
RUN apt-get update && apt-get install -y --no-install-recommends \
    chromium \
    libnss3 \
    libxss1 \
    libasound2 \
    libatk-bridge2.0-0 \
    libgtk-3-0 \
    libgbm1 \
    p7zip-full \
    python3 \
    make \
    g++ \
    ca-certificates \
    curl \
    dumb-init \
    && rm -rf /var/lib/apt/lists/* && \
    # Clean up apt cache to reduce image size
    rm -rf /var/lib/apt/lists/*

WORKDIR /app

# Copy dependency definitions only (not package-lock for reproducibility)
COPY package*.json ./

# Install all dependencies
RUN npm install --no-optional && \
    npm cache clean --force

# Copy application source code
COPY . .

# Build production frontend
RUN npm run build

# Create persistent storage directories with secure ownership
RUN mkdir -p /data /uploads/thumbnails /uploads/models /uploads/tmp \
    && chown -R node:node /data /uploads \
    && chmod -R 750 /data /uploads

# Declare persistent volumes so data persists across container restarts
VOLUME ["/data", "/uploads"]

# Expose server port
EXPOSE 3000

# Health check endpoint
HEALTHCHECK --interval=30s --timeout=10s --start-period=60s --retries=3 \
  CMD curl -f http://localhost:3000/api/health || exit 1

# SECURITY FIX #1: Hard-coded startup validation
# This script runs at container boot and blocks startup if secrets are missing.
COPY server/startup-validation.js ./startup-validation.js

LABEL com.github.dockerlab.security.fix="secret-enforcement" \
      com.github.dockerlab.security.version="2026-11-02" \
      com.github.dockerlab.description="Hard-coded secret enforcement at container startup to prevent insecure deployments."
# Use dumb-init as PID 1 to prevent zombie process accumulation
ENTRYPOINT ["/usr/bin/dumb-init", "--"]
CMD ["npm", "start"]